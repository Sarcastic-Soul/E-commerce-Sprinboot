# Local development secrets — copy to `secrets.properties` and fill in.
#
#   cp backend/secrets.properties.example backend/secrets.properties
#
# `secrets.properties` is gitignored and dockerignored, so it never leaves your
# machine. These are the same names Render uses, so what works here works there.
#
# Real OS environment variables still win over this file, so you can override any
# single value ad hoc with `JWT_SECRET=... ./mvnw spring-boot:run ...`.

# Any random string of 32+ chars. Generate one with: openssl rand -base64 48
# If unset, a throwaway key is generated at each restart and all tokens die with it.
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
