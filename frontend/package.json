{
    "name": "spring-e-commerce",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "lint": "oxlint",
        "preview": "vite preview",
        "gen:api": "pnpm dlx --package=openapi-typescript@7 --package=typescript@6 openapi-typescript ${API_DOCS_URL:-http://localhost:8080/v3/api-docs} --properties-required-by-default -o src/api/schema.d.ts"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query": "^5.107.1",
        "axios": "^1.21.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "7.0.2007",
        "typescript": "~7.0.2",
        "vite": "^8.3.8"
    },
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=22.22"
    }
}
